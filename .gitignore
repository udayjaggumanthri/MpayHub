# =============================================================================
# mPayHub monorepo — root .gitignore
# =============================================================================
# App-specific rules also live in backend/.gitignore and frontend/.gitignore.
# This file covers shared and historically missed paths (secrets, dumps, IDE).
# =============================================================================

# Secrets / env
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.env.bak
**/.env.bak

# Python
**/__pycache__/
**/*.py[cod]
**/.Python
**/venv/
**/.venv/
**/ENV/

# Node
**/node_modules/
npm-debug.log*
yarn-error.log*

# Django local artifacts
**/db.sqlite3
**/db.sqlite3-journal
backend/media/
backend/staticfiles/
backend/logs/
*.log

# Database dumps / backups (never commit customer data)
*.dump
*.sql.gz
backups/
**/backups/

# Test / coverage
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/coverage/

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
