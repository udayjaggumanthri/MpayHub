# =============================================================================
# mPayHub backend environment (.env)
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Rules:
# - Put comments on their own line (NOT inline after values — decouple reads the full line).
# - After changing .env on a VPS: pm2 restart mpayhub-backend --update-env
# - BillAvenue Working Key / IV are stored encrypted in the DB (Admin → BBPS → BillAvenue Settings),
#   not in this file. API Master / SMTP passwords are also in the DB.
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# development | production | testing
# Live UAT/prod PM2 uses DJANGO_ENV=production (ecosystem.config.cjs). Match that here.
# Never set DJANGO_ENV=testing on the live server (empty ALLOWED_HOSTS → login HTML 400).
# UAT vs prod: same code; swap DATABASE_URL, ALLOWED_HOSTS, CORS_*, CSRF_* in .env only.
# Frontend must use REACT_APP_API_BASE_URL=/api (same-origin via nginx) on both servers.
DJANGO_ENV=production

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# production.py requires a strong key (not django-insecure-..., min 40 chars).
SECRET_KEY=change-this-to-a-secure-random-value

DEBUG=True

# Comma-separated hosts (no spaces after commas). Use * only for dev/staging.
ALLOWED_HOSTS=localhost,127.0.0.1,partner.mpayhub.in

# Comma-separated origins with scheme (required for CSRF behind HTTPS/nginx).
CSRF_TRUSTED_ORIGINS=https://partner.mpayhub.in

# Behind nginx with HTTPS termination
SECURE_SSL_REDIRECT=False

# -----------------------------------------------------------------------------
# Cryptography (do not rotate casually on a live DB)
# -----------------------------------------------------------------------------
# MPIN encryption at rest. If users already have MPINs, keep the key that was used when they were created.
# MPIN_ENCRYPTION_KEY=django-insecure-change-this-in-production

# Decrypts BillAvenue Working Key/IV, API Master secrets, SMTP passwords stored in Postgres.
# If you rotate SECRET_KEY, set this to the key that was active when those secrets were saved.
# INTEGRATION_SECRET_KEY=django-insecure-change-this-in-production

# Legacy / docs only — new MPINs use MPIN_ENCRYPTION_KEY, not ENCRYPTION_KEY.
ENCRYPTION_KEY=change-this-32-char-encryption-key-minimum

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Preferred: single URL (postgres:// or postgresql://)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mpayhub

# Use SQLite for local dev without Postgres
USE_SQLITE=False

# Alternative if DATABASE_URL is unset:
# DB_NAME=mpayhub
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Connection pooling (Postgres)
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True

# -----------------------------------------------------------------------------
# Cache / Redis (required when REDIS_URL is set)
# -----------------------------------------------------------------------------
# Login, session security, BBPS catalog cache, and rate limits use Redis when configured.
# Install: pip install -r requirements-prod.txt  +  sudo apt install redis-server
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# development defaults to True; production defaults to False
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://partner.mpayhub.in
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# Email (fallback when no Admin → SMTP config in DB)
# -----------------------------------------------------------------------------
# development uses console backend regardless of these vars.
# production uses SMTP when DJANGO_ENV=production.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# -----------------------------------------------------------------------------
# Session security / GeoIP
# -----------------------------------------------------------------------------
# http (default) | maxmind (requires GEOIP_DB_PATH + geoip2 package)
GEOIP_PROVIDER=http
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb

# -----------------------------------------------------------------------------
# Payment gateways (optional — many keys live in Admin → API Master)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# -----------------------------------------------------------------------------
# Legacy integration placeholders (prefer Admin → API Master in DB)
# -----------------------------------------------------------------------------
BBPS_API_KEY=
BBPS_API_URL=

SMS_API_KEY=
SMS_API_URL=
SMS_PROVIDER=console

BANK_VALIDATION_API_KEY=
BANK_VALIDATION_API_URL=

# -----------------------------------------------------------------------------
# BBPS / business defaults (optional overrides)
# -----------------------------------------------------------------------------
BBPS_SERVICE_CHARGE=5.0
BANK_VERIFICATION_CHARGE=3.0
# BBPS_PROVIDER_GOVERNANCE_ENABLED=True
# BBPS_AUTO_PULL_PLANS_ON_SYNC=True
# BBPS_ASSISTED_CARD_PAYMENT_UI=mdm_strict

# -----------------------------------------------------------------------------
# Payout slab defaults (optional)
# -----------------------------------------------------------------------------
# PAYOUT_SLAB_LOW_MAX=24999
# PAYOUT_CHARGE_LOW=7
# PAYOUT_CHARGE_HIGH=15

# -----------------------------------------------------------------------------
# Pay-in platform settlement (optional)
# -----------------------------------------------------------------------------
# User id that receives 100% of gateway + admin commission slices; blank = split across Admins
# PLATFORM_PAYIN_SETTLEMENT_USER_ID=

# -----------------------------------------------------------------------------
# Media storage (local disk or private S3 — same code; only .env differs)
# -----------------------------------------------------------------------------
# USE_S3=False → files under MEDIA_ROOT (backend/media), same-origin /media/
# USE_S3=True  → shared bucket; isolate envs with AWS_S3_MEDIA_PREFIX only
#   UAT:  AWS_S3_MEDIA_PREFIX=uat
#   Prod: AWS_S3_MEDIA_PREFIX=prod
# nginx must proxy /media/ → Gunicorn (not disk alias) when using S3.
# Sync first: aws s3 sync backend/media/ s3://$AWS_STORAGE_BUCKET_NAME/$AWS_S3_MEDIA_PREFIX/
# Rollback: USE_S3=False + restore nginx disk alias; keep local media until verified.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_MEDIA_PREFIX=
# AWS_S3_SIGNATURE_VERSION=s3v4
# Do not set public ACLs; MediaStorage.url always returns /media/... paths.
# nginx proxies /media/ with optional proxy_cache (see deploy/nginx/mpayhub-media-cache.conf).
#
# Auto sync: when USE_S3=True, backend start runs `manage.py sync_local_media_to_s3`
# (uploads local media/ files missing on S3; skips same-size existing objects).
# Manual: cd backend && ./venv/bin/python manage.py sync_local_media_to_s3

# -----------------------------------------------------------------------------
# Production hardening (when DJANGO_ENV=production)
# -----------------------------------------------------------------------------
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
